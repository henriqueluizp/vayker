---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import GlassCard from '../components/GlassCard.astro';
import PhoneFrame from '../components/PhoneFrame.astro';
import homePng from '../assets/home.png';
import viagemPng from '../assets/viagem.png';
import financeiroPng from '../assets/financeiro.png';
import logoPng from '../assets/logo.png';

const features = [
  {
    icon: 'map',
    title: 'Roteiro colaborativo',
    description:
      'Crie e edite o itinerário com todo mundo do grupo em tempo real. Cada parada, atividade e horário — visível para todos, o tempo todo.',
  },
  {
    icon: 'wallet',
    title: 'Divisão inteligente de gastos',
    description:
      'Registre cada despesa e o Vayker calcula automaticamente quem deve pra quem. Chega de planilha e confusão no fim da viagem.',
  },
  {
    icon: 'key',
    title: 'Convite por PIN',
    description:
      'Compartilhe um código de 6 dígitos e pronto. Sem links que expiram, sem convites perdidos na bagunça do grupo de WhatsApp.',
  },
  {
    icon: 'sync',
    title: 'Sincronização em tempo real',
    description:
      'Qualquer alteração aparece instantaneamente para todos os participantes. Sem apertar F5, sem "atualiza aí pra eu ver".',
  },
  {
    icon: 'sparkle',
    title: 'Interface premium',
    description:
      'Design escuro, moderno e fluido — pensado para ser bonito e fácil de usar, mesmo no meio do caos gostoso de uma viagem.',
  },
  {
    icon: 'stack',
    title: 'Tudo num só lugar',
    description:
      'Itinerário, gastos, participantes e fotos centralizados num app só. Adeus, dez abas abertas e três grupos diferentes.',
  },
];

const steps = [
  {
    number: 1,
    title: 'Crie sua viagem',
    description: 'Em segundos, defina o destino e as datas. É rápido como montar a mala — só que sem o estresse.',
  },
  {
    number: 2,
    title: 'Convide o grupo',
    description: 'Compartilhe o PIN de 6 dígitos com os amigos. Quem tiver o código entra na hora, sem burocracia.',
  },
  {
    number: 3,
    title: 'Planejem juntos',
    description: 'Monte o roteiro com paradas, horários e atividades. Todo mundo vê e edita — colaboração de verdade.',
  },
  {
    number: 4,
    title: 'Dividam os gastos',
    description: 'Registre cada despesa durante a viagem. No final, o app mostra exatamente quem deve o quê pra quem.',
  },
];

const showcaseItems = [
  { image: homePng, alt: 'Tela inicial do Vayker', label: 'Início', rotate: -2 },
  { image: viagemPng, alt: 'Roteiro de viagem no Vayker', label: 'Roteiro', rotate: 1 },
  { image: financeiroPng, alt: 'Divisão de gastos no Vayker', label: 'Gastos', rotate: -1 },
];

const stores = ['App Store', 'Google Play'];

const icons: Record<string, string> = {
  map: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#8B5CF6" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/><circle cx="12" cy="9" r="2.5"/></svg>`,
  wallet: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#8B5CF6" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M2 10h20"/><path d="M16 14h.01"/><circle cx="16" cy="14" r="1.5"/></svg>`,
  key: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#8B5CF6" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="14" r="5"/><path d="M12 10l7-7"/><path d="M16.5 5.5L19 3"/><path d="M22 3l-2.5 2.5"/></svg>`,
  sync: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#8B5CF6" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2v6h-6"/><path d="M3 22v-6h6"/><path d="M3.51 9a9 9 0 0114.85-3.36L21 8"/><path d="M20.49 15a9 9 0 01-14.85 3.36L3 16"/></svg>`,
  sparkle: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#8B5CF6" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l2.5 6.5L21 9l-6.5 2.5L12 18l-2.5-6.5L3 9l6.5-2.5z"/></svg>`,
  stack: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#8B5CF6" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>`,
};
---

<Layout>
  <!-- ============================================================ -->
  <!--  HERO — Brand banner (zero screenshots)                       -->
  <!-- ============================================================ -->
  <section class="relative overflow-hidden px-6 pt-16 pb-8 sm:pt-28 sm:pb-12 lg:pt-36 lg:pb-16">
    <!-- Decorative background lines -->
    <div class="pointer-events-none absolute inset-0 overflow-hidden opacity-[0.03]" aria-hidden="true">
      <div class="absolute top-0 left-1/2 h-full w-px bg-gradient-to-b from-transparent via-violet to-transparent"></div>
      <div class="absolute top-0 left-[20%] h-full w-px bg-gradient-to-b from-transparent via-indigo/50 to-transparent"></div>
      <div class="absolute top-0 right-[20%] h-full w-px bg-gradient-to-b from-transparent via-cyan/30 to-transparent"></div>
    </div>

    <div class="mx-auto flex max-w-3xl flex-col items-center text-center">
      <!-- Status badge -->
      <div class="reveal mb-8 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.04] px-4 py-1.5 backdrop-blur-xl">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-violet opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-violet"></span>
        </span>
        <span class="text-xs font-medium text-muted">Em desenvolvimento — lançamento em breve</span>
      </div>

      <!-- Logo -->
      <div class="reveal reveal-delay-1 relative mb-8">
        <!-- Outer glow ring -->
        <div class="absolute inset-0 -inset-8 rounded-full bg-gradient-to-tr from-violet/20 via-indigo/15 to-cyan/10 blur-2xl"></div>
        <!-- Logo container -->
        <div class="relative mx-auto flex h-24 w-24 items-center justify-center rounded-[28px] bg-gradient-to-br from-violet via-indigo to-violet p-5 shadow-[0_24px_60px_-20px_rgba(139,92,246,0.7),0_0_120px_-40px_rgba(139,92,246,0.4)] sm:h-28 sm:w-28 sm:rounded-[32px] sm:p-6">
          <Image
            src={logoPng}
            alt="Vayker"
            width={112}
            height={112}
            loading="eager"
            fetchpriority="high"
            class="h-full w-full object-contain"
          />
        </div>
      </div>

      <!-- Headline -->
      <h1 class="reveal reveal-delay-2 font-display text-4xl leading-[1.08] font-extrabold tracking-tight text-ink sm:text-5xl lg:text-6xl">
        Sua viagem em grupo,<br />
        <span class="bg-gradient-to-r from-violet via-indigo to-cyan bg-clip-text text-transparent">
          organizada de verdade.
        </span>
      </h1>

      <!-- Subtext -->
      <p class="reveal reveal-delay-3 mx-auto mt-6 max-w-lg text-base leading-relaxed text-muted sm:text-lg">
        Itinerário colaborativo, divisão de gastos automática e convite por PIN.
        O app que transforma o caos de viajar em grupo em memórias que valem a pena.
      </p>

      <!-- Store badges -->
      <div class="reveal reveal-delay-4 mt-8 flex flex-col items-center gap-3 sm:flex-row">
        {
          stores.map((store) => (
            <button
              class="inline-flex items-center gap-2 rounded-xl border border-white/10 bg-white/[0.06] px-5 py-3 text-sm font-semibold text-ink backdrop-blur-xl transition-all duration-300 hover:border-violet/30 hover:bg-white/[0.10] hover:shadow-[0_0_30px_-8px_rgba(139,92,246,0.3)]"
            >
              <span class="text-base">↓</span>
              {store}
              <span class="ml-1 text-xs font-normal text-violet">· em breve</span>
            </button>
          ))
        }
      </div>

      <!-- Stats row -->
      <div class="reveal reveal-delay-5 mt-10 flex flex-wrap items-center justify-center gap-6 text-sm text-muted">
        <div class="flex items-center gap-1.5">
          <span class="font-display text-lg font-bold text-ink">100%</span>
          <span>grátis</span>
        </div>
        <span class="h-1 w-1 rounded-full bg-white/10"></span>
        <div class="flex items-center gap-1.5">
          <span class="font-display text-lg font-bold text-ink">BR</span>
          <span>feito no Brasil</span>
        </div>
        <span class="h-1 w-1 rounded-full bg-white/10"></span>
        <div class="flex items-center gap-1.5">
          <span class="font-display text-lg font-bold text-ink">PIN</span>
          <span>convite simples</span>
        </div>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="mt-20 flex justify-center sm:mt-24">
      <div class="scroll-indicator flex flex-col items-center gap-2 text-muted">
        <span class="text-xs font-medium tracking-widest uppercase">Role para descobrir</span>
        <span class="scroll-arrow block h-6 w-4 rounded-full border border-white/10"></span>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!--  APP SHOWCASE                                                 -->
  <!-- ============================================================ -->
  <section class="px-6 py-16 sm:py-24">
    <div class="mx-auto max-w-6xl">
      <div class="mb-12 text-center reveal">
        <span class="mb-4 inline-block rounded-full bg-violet/10 px-3 py-1 text-xs font-semibold tracking-wider text-violet uppercase">
          Dentro do app
        </span>
        <h2 class="font-display text-3xl font-bold text-ink sm:text-4xl">
          Bonito por dentro e por fora
        </h2>
        <p class="mx-auto mt-3 max-w-md text-muted">
          Cada tela foi desenhada com o mesmo cuidado que você coloca ao planejar sua próxima viagem.
        </p>
      </div>

      <div class="flex flex-wrap items-start justify-center gap-6 sm:gap-10 lg:gap-14 reveal">
        {
          showcaseItems.map((item) => (
            <PhoneFrame
              image={item.image}
              alt={item.alt}
              label={item.label}
              rotate={item.rotate}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!--  FEATURES                                                     -->
  <!-- ============================================================ -->
  <section class="border-t border-white/[0.04] px-6 py-16 sm:py-24">
    <div class="mx-auto max-w-6xl">
      <div class="mb-14 text-center reveal">
        <span class="mb-4 inline-block rounded-full bg-indigo/10 px-3 py-1 text-xs font-semibold tracking-wider text-indigo uppercase">
          Funcionalidades
        </span>
        <h2 class="font-display text-3xl font-bold text-ink sm:text-4xl">
          Tudo que você precisa pra viajar em grupo
        </h2>
        <p class="mx-auto mt-3 max-w-lg text-muted">
          Sem planilhas, sem mensagens perdidas, sem "quem pagou o quê mesmo?". O Vayker resolve.
        </p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          features.map((f, i) => (
            <GlassCard class="group/card p-6 sm:p-8 reveal">
              <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-violet/20 to-indigo/20 ring-1 ring-white/[0.06] transition-all duration-300 group-hover/card:from-violet/30 group-hover/card:to-indigo/30 group-hover/card:shadow-[0_0_25px_-6px_rgba(139,92,246,0.3)]">
                <span class="flex items-center justify-center" set:html={icons[f.icon] || ''} />
              </div>
              <h3 class="font-display text-lg font-semibold text-ink">{f.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{f.description}</p>
            </GlassCard>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!--  HOW IT WORKS                                                 -->
  <!-- ============================================================ -->
  <section class="border-t border-white/[0.04] px-6 py-16 sm:py-24">
    <div class="mx-auto max-w-4xl">
      <div class="mb-14 text-center reveal">
        <span class="mb-4 inline-block rounded-full bg-cyan/10 px-3 py-1 text-xs font-semibold tracking-wider text-cyan uppercase">
          Como funciona
        </span>
        <h2 class="font-display text-3xl font-bold text-ink sm:text-4xl">
          Do caos à organização em 4 passos
        </h2>
      </div>

      <div class="relative">
        <!-- Vertical line (desktop) -->
        <div class="absolute top-0 bottom-0 left-[19px] hidden w-px bg-gradient-to-b from-violet/60 via-indigo/40 to-transparent sm:block"></div>

        <div class="flex flex-col gap-8 sm:gap-6">
          {
            steps.map((step, i) => (
              <div class="flex gap-5 reveal sm:gap-8">
                <!-- Step number -->
                <div class="relative z-10 flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-violet to-indigo text-sm font-bold text-white shadow-[0_8px_25px_-8px_rgba(139,92,246,0.5)] sm:h-12 sm:w-12 sm:text-base">
                  {step.number}
                </div>
                <!-- Content -->
                <GlassCard class="flex-1 p-5 sm:p-6">
                  <h3 class="font-display text-base font-semibold text-ink sm:text-lg">{step.title}</h3>
                  <p class="mt-1.5 text-sm leading-relaxed text-muted">{step.description}</p>
                </GlassCard>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!--  CTA                                                          -->
  <!-- ============================================================ -->
  <section class="border-t border-white/[0.04]">
    <div class="mx-auto max-w-3xl px-6 py-20 text-center sm:py-28">
      <div class="reveal">
        <!-- Logo glow -->
        <div class="mx-auto mb-8 flex h-20 w-20 items-center justify-center rounded-2xl bg-gradient-to-br from-violet via-indigo to-violet p-4 shadow-[0_20px_50px_-16px_rgba(139,92,246,0.7),0_0_80px_-20px_rgba(139,92,246,0.3)]">
          <Image
            src={logoPng}
            alt="Vayker"
            width={80}
            height={80}
            loading="lazy"
            class="h-full w-full object-contain"
          />
        </div>

        <h2 class="font-display text-3xl font-bold text-ink sm:text-4xl lg:text-5xl">
          A próxima viagem em grupo<br />começa aqui.
        </h2>

        <p class="mx-auto mt-4 max-w-md text-muted sm:text-lg">
          Estamos na reta final de desenvolvimento. O Vayker chega em breve na App Store e no Google Play.
        </p>

        <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
          {
            stores.map((store) => (
              <span class="inline-flex items-center gap-2 rounded-xl border border-white/10 bg-white/[0.06] px-6 py-3.5 text-sm font-semibold text-ink backdrop-blur-xl transition-all duration-300 hover:border-violet/30 hover:bg-white/[0.10] hover:shadow-[0_0_30px_-8px_rgba(139,92,246,0.3)]">
                <span class="text-base">↓</span>
                {store}
                <span class="ml-1 text-xs font-normal text-violet">· em breve</span>
              </span>
            ))
          }
        </div>

        <p class="mt-6 text-xs text-muted/60">
          Fique de olho — ou mande um e-mail pra gente: <a href="mailto:app.vayker@gmail.com" class="text-violet hover:underline">app.vayker@gmail.com</a>
        </p>
      </div>
    </div>
  </section>
</Layout>

<!-- Scroll reveal script -->
<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry, i) => {
        if (entry.isIntersecting) {
          setTimeout(() => {
            entry.target.classList.add('revealed');
          }, i * 80);
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
  );

  document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
</script>
