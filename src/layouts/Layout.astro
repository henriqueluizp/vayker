---
import { Image } from 'astro:assets';
import '../styles/global.css';
import AuroraBackground from '../components/AuroraBackground.astro';
import logoPng from '../assets/logo.png';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Vayker — Viaje. Organize. Repita.',
  description = 'Vayker é o app pra organizar viagens em grupo: itinerário colaborativo, divisão de despesas e acerto de contas automático.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, 'https://vayker.com');

const nav = [
  { href: '/', label: 'Início' },
  { href: '/termos', label: 'Termos de Uso' },
  { href: '/privacidade', label: 'Privacidade' },
];

const footerLinks = {
  produto: [
    { href: '/', label: 'Início' },
    { href: '#features', label: 'Funcionalidades' },
    { href: '#showcase', label: 'App' },
  ],
  empresa: [
    { href: '/termos', label: 'Termos de Uso' },
    { href: '/privacidade', label: 'Privacidade' },
    { href: 'mailto:app.vayker@gmail.com', label: 'Contato' },
  ],
};

const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700;12..96,800&family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://vayker.com/images/logo-bg.png" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: 'Vayker',
      url: 'https://vayker.com',
      applicationCategory: 'TravelApplication',
      operatingSystem: 'Android, iOS',
      description,
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'BRL',
      },
    })} />
  </head>
  <body class="min-h-screen font-sans text-ink antialiased">
    <AuroraBackground />

    <!-- Nav -->
    <header class="sticky top-0 z-50 border-b border-white/[0.04] bg-bg/70 backdrop-blur-xl">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-3.5">
        <a href="/" class="flex items-center gap-2.5 transition-opacity hover:opacity-90">
          <span
            class="flex h-8 w-8 items-center justify-center rounded-[10px] bg-gradient-to-br from-violet via-indigo to-violet p-1.5 shadow-[0_6px_16px_-4px_rgba(139,92,246,0.6)]"
          >
            <Image
              src={logoPng}
              alt=""
              width={32}
              height={32}
              loading="eager"
              class="h-full w-full object-contain"
            />
          </span>
          <span class="font-display text-lg font-bold tracking-tight text-ink">
            Vay<span class="text-violet">Ker</span>
          </span>
        </a>
        <nav class="flex items-center gap-1 text-sm">
          {
            nav.map((item) => (
              <a
                href={item.href}
                class:list={[
                  'rounded-full px-4 py-2 font-medium transition-all duration-200',
                  Astro.url.pathname === item.href
                    ? 'bg-white/10 text-ink shadow-sm'
                    : 'text-muted hover:bg-white/[0.04] hover:text-ink',
                ]}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-white/[0.04] bg-bg-soft/50">
      <div class="mx-auto max-w-6xl px-6 py-16">
        <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-4">
          <!-- Brand -->
          <div class="lg:col-span-1">
            <a href="/" class="flex items-center gap-2.5">
              <span
                class="flex h-8 w-8 items-center justify-center rounded-[10px] bg-gradient-to-br from-violet via-indigo to-violet p-1.5 shadow-[0_6px_16px_-4px_rgba(139,92,246,0.6)]"
              >
                <Image
                  src={logoPng}
                  alt="Vayker"
                  width={32}
                  height={32}
                  loading="lazy"
                  class="h-full w-full object-contain"
                />
              </span>
              <span class="font-display text-lg font-bold tracking-tight text-ink">
                Vay<span class="text-violet">Ker</span>
              </span>
            </a>
            <p class="mt-4 text-sm leading-relaxed text-muted">
              O app pra organizar viagens em grupo sem estresse. Roteiro, gastos e convite por PIN — tudo num só lugar.
            </p>
          </div>

          <!-- Produto -->
          <div>
            <h4 class="mb-4 font-display text-sm font-semibold text-ink">Produto</h4>
            <ul class="flex flex-col gap-2.5">
              {footerLinks.produto.map((link) => (
                <li>
                  <a href={link.href} class="text-sm text-muted transition-colors hover:text-ink">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <!-- Empresa -->
          <div>
            <h4 class="mb-4 font-display text-sm font-semibold text-ink">Empresa</h4>
            <ul class="flex flex-col gap-2.5">
              {footerLinks.empresa.map((link) => (
                <li>
                  <a href={link.href} class="text-sm text-muted transition-colors hover:text-ink">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <!-- Status -->
          <div>
            <h4 class="mb-4 font-display text-sm font-semibold text-ink">Status</h4>
            <div class="flex items-center gap-2">
              <span class="relative flex h-2 w-2">
                <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-violet opacity-75"></span>
                <span class="relative inline-flex h-2 w-2 rounded-full bg-violet"></span>
              </span>
              <span class="text-sm text-muted">Em desenvolvimento</span>
            </div>
            <p class="mt-3 text-sm text-muted">
              App Store e Google Play em breve.
            </p>
          </div>
        </div>

        <!-- Bottom bar -->
        <div class="mt-12 flex flex-col items-center gap-4 border-t border-white/[0.04] pt-8 text-sm text-muted sm:flex-row sm:justify-between">
          <p>© {currentYear} Vayker. Todos os direitos reservados.</p>
          <div class="flex gap-6">
            <a href="/termos" class="transition-colors hover:text-ink">Termos de Uso</a>
            <a href="/privacidade" class="transition-colors hover:text-ink">Privacidade</a>
            <a href="mailto:app.vayker@gmail.com" class="transition-colors hover:text-ink">Contato</a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
