---
import { Image } from 'astro:assets';
import '../styles/global.css';
import AuroraBackground from '../components/AuroraBackground.astro';
import SiteAnimations from '../components/SiteAnimations.astro';
import BackToTop from '../components/BackToTop.astro';
import logoPng from '../assets/logo.png';
import { getAlternateLangPath, getLangFromUrl, useTranslations } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const altLangPath = getAlternateLangPath(Astro.url);

const { title = t('meta.title'), description = t('meta.description') } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, 'https://vayker.com');

const legalPath =
  lang === 'en' ? { terms: '/en/terms', privacy: '/en/privacy' } : { terms: '/termos', privacy: '/privacidade' };

const footerLinks = {
  produto: [
    { href: '#features', label: t('footer.features') },
    { href: '#showcase', label: t('footer.app') },
  ],
  empresa: [
    { href: legalPath.terms, label: t('footer.terms') },
    { href: legalPath.privacy, label: t('footer.privacy') },
    { href: 'mailto:app.vayker@gmail.com', label: t('footer.contact') },
  ],
};

const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang={lang === 'en' ? 'en' : 'pt-BR'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700;12..96,800&family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500;600&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700;12..96,800&family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500;600&display=swap"
      />
    </noscript>

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://vayker.com/images/logo-bg.png" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: 'Vayker',
      url: 'https://vayker.com',
      applicationCategory: 'TravelApplication',
      operatingSystem: 'Android, iOS',
      description,
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'BRL',
      },
    })} />
  </head>
  <body class="min-h-screen font-sans text-ink antialiased">
    <AuroraBackground />

    <!-- Nav -->
    <header class="sticky top-0 z-50 border-b border-white/[0.04] bg-bg/70 backdrop-blur-xl">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-3.5">
        <a href={lang === 'en' ? '/en' : '/'} class="flex items-center gap-2.5 transition-opacity hover:opacity-90">
          <span
            class="flex h-8 w-8 items-center justify-center rounded-[10px] bg-gradient-to-br from-violet via-indigo to-violet p-1.5 shadow-[0_6px_16px_-4px_rgba(139,92,246,0.6)]"
          >
            <Image
              src={logoPng}
              alt=""
              width={32}
              height={32}
              loading="eager"
              class="h-full w-full object-contain"
            />
          </span>
          <span class="font-display text-lg font-bold tracking-tight text-ink">
            Vay<span class="text-violet">Ker</span>
          </span>
        </a>
        <a
          href={altLangPath}
          class="rounded-full border border-white/10 px-3.5 py-1.5 text-sm font-medium text-muted transition-colors hover:border-violet/30 hover:text-ink"
        >
          {t('lang.switchTo')}
        </a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-white/[0.04] bg-bg-soft/50">
      <div class="mx-auto max-w-6xl px-6 py-16">
        <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-4">
          <!-- Brand -->
          <div class="lg:col-span-1">
            <a href={lang === 'en' ? '/en' : '/'} class="flex items-center gap-2.5">
              <span
                class="flex h-8 w-8 items-center justify-center rounded-[10px] bg-gradient-to-br from-violet via-indigo to-violet p-1.5 shadow-[0_6px_16px_-4px_rgba(139,92,246,0.6)]"
              >
                <Image
                  src={logoPng}
                  alt="Vayker"
                  width={32}
                  height={32}
                  loading="lazy"
                  class="h-full w-full object-contain"
                />
              </span>
              <span class="font-display text-lg font-bold tracking-tight text-ink">
                Vay<span class="text-violet">Ker</span>
              </span>
            </a>
            <p class="mt-4 text-sm leading-relaxed text-muted">
              {t('footer.tagline')}
            </p>
          </div>

          <!-- Produto -->
          <div>
            <h4 class="mb-4 font-display text-sm font-semibold text-ink">{t('footer.product')}</h4>
            <ul class="flex flex-col gap-2.5">
              {footerLinks.produto.map((link) => (
                <li>
                  <a href={link.href} class="text-sm text-muted transition-colors hover:text-ink">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <!-- Empresa -->
          <div>
            <h4 class="mb-4 font-display text-sm font-semibold text-ink">{t('footer.company')}</h4>
            <ul class="flex flex-col gap-2.5">
              {footerLinks.empresa.map((link) => (
                <li>
                  <a href={link.href} class="text-sm text-muted transition-colors hover:text-ink">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <!-- Status -->
          <div>
            <h4 class="mb-4 font-display text-sm font-semibold text-ink">{t('footer.status')}</h4>
            <div class="flex items-center gap-2">
              <span class="relative flex h-2 w-2">
                <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-violet opacity-75"></span>
                <span class="relative inline-flex h-2 w-2 rounded-full bg-violet"></span>
              </span>
              <span class="text-sm text-muted">{t('footer.statusLine')}</span>
            </div>
            <p class="mt-3 text-sm text-muted">
              {t('footer.statusSub')}
            </p>
          </div>
        </div>

        <!-- Bottom bar -->
        <div class="mt-12 flex flex-col items-center gap-4 border-t border-white/[0.04] pt-8 text-sm text-muted sm:flex-row sm:justify-between">
          <p>© {currentYear} Vayker. {t('footer.rights')}</p>
          <div class="flex gap-6">
            {footerLinks.empresa.map((link) => (
              <a href={link.href} class="transition-colors hover:text-ink">{link.label}</a>
            ))}
          </div>
        </div>
      </div>
    </footer>

    <SiteAnimations />
    <BackToTop />
  </body>
</html>
