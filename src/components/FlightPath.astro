---
// Full-page vertical flight path — the journey spine
// Fixed canvas on the left side, airplane travels top→bottom as user scrolls.
// Waypoints = page sections. Content reveals sync with scroll (via existing reveal animations).
---

<canvas
  id="journey-canvas"
  class="journey-canvas"
  aria-hidden="true"
></canvas>

<script>
  // ================================================================
  //  COLORS (match app's auth_tokens.dart + site palette)
  // ================================================================
  const C = {
    traveled: '#8B5CF6',
    pending: 'rgba(166, 161, 194, 0.35)',
    surface: '#0B0A14',
    arrived: '#22C55E',
    white: '#FFFFFF',
  };

  // Fraction positions (0-1) of sections on the page
  // We'll calculate these dynamically from section elements
  let waypointFractions = [];

  // ================================================================
  //  GEOMETRY
  // ================================================================
  function bezier(p0, p1, p2, p3, t) {
    const mt = 1 - t;
    return mt * mt * mt * p0 + 3 * mt * mt * t * p1 + 3 * mt * t * t * p2 + t * t * t * p3;
  }

  // ================================================================
  //  ROUTE — multi-segment winding flight path (not a straight line!)
  //  Chain of cubic beziers creating a serpentine journey top→bottom.
  // ================================================================
  function buildRoute(w, h) {
    const pad = 28;
    const mid = w * 0.5;

    // Define segments as [startX, startY, cp1x, cp1y, cp2x, cp2y, endX, endY]
    // Each segment connects end-to-end: segment N's end = segment N+1's start
    const segments = [
      // 1. Takeoff: left side → swing right and up
      {
        sx: mid - 10, sy: pad,
        c1x: mid - 14, c1y: h * 0.06,
        c2x: mid + 16, c2y: h * 0.12,
        ex: mid + 12, ey: h * 0.20,
      },
      // 2. Cruise: right → sweep left
      {
        sx: mid + 12, sy: h * 0.20,
        c1x: mid + 18, c1y: h * 0.26,
        c2x: mid - 18, c2y: h * 0.34,
        ex: mid - 14, ey: h * 0.42,
      },
      // 3. Mid-journey: left → curve back right
      {
        sx: mid - 14, sy: h * 0.42,
        c1x: mid - 20, c1y: h * 0.49,
        c2x: mid + 20, c2y: h * 0.57,
        ex: mid + 10, ey: h * 0.64,
      },
      // 4. Approach: right → gentle left curve
      {
        sx: mid + 10, sy: h * 0.64,
        c1x: mid + 16, c1y: h * 0.72,
        c2x: mid - 12, c2y: h * 0.81,
        ex: mid - 6, ey: h * 0.88,
      },
      // 5. Landing: left → center bottom
      {
        sx: mid - 6, sy: h * 0.88,
        c1x: mid - 10, c1y: h * 0.93,
        c2x: mid + 4, c2y: h * 0.97,
        ex: mid, ey: h - pad + 4,
      },
    ];

    const stepsPerSegment = 80;
    const points = [];
    let totalLen = 0;

    for (let s = 0; s < segments.length; s++) {
      const seg = segments[s];
      for (let i = 0; i <= stepsPerSegment; i++) {
        const t = i / stepsPerSegment;
        const x = bezier(seg.sx, seg.c1x, seg.c2x, seg.ex, t);
        const y = bezier(seg.sy, seg.c1y, seg.c2y, seg.ey, t);
        if (points.length > 0) {
          const prev = points[points.length - 1];
          const dx = x - prev.x;
          const dy = y - prev.y;
          totalLen += Math.sqrt(dx * dx + dy * dy);
        }
        // Skip duplicate start point (except first segment)
        if (i === 0 && s > 0) continue;
        points.push({ x, y, len: totalLen, t: (s + t) / segments.length });
      }
    }

    return {
      points,
      length: totalLen,
      pointAt(fraction) {
        const target = Math.max(0, Math.min(totalLen, totalLen * fraction));
        let lo = 0, hi = points.length - 1;
        while (lo < hi - 1) {
          const mid = (lo + hi) >> 1;
          if (points[mid].len < target) lo = mid;
          else hi = mid;
        }
        return points[hi];
      },
    };
  }

  // ================================================================
  //  DRAWING
  // ================================================================
  function drawPlane(ctx, pt, angle, color) {
    ctx.save();
    ctx.translate(pt.x, pt.y);
    ctx.rotate(angle);

    // Glow halo
    const haloColor = color === C.arrived
      ? 'rgba(34, 197, 94, 0.18)'
      : 'rgba(139, 92, 246, 0.18)';
    ctx.beginPath();
    ctx.arc(0, 0, 11, 0, Math.PI * 2);
    ctx.fillStyle = haloColor;
    ctx.fill();

    // Paper airplane — same polygon as Flutter FlightProgress
    const scale = 1.0;
    ctx.beginPath();
    ctx.moveTo(9 * scale, 0);
    ctx.lineTo(-6 * scale, 5.5 * scale);
    ctx.lineTo(-2.8 * scale, 0);
    ctx.lineTo(-6 * scale, -5.5 * scale);
    ctx.closePath();
    ctx.fillStyle = color;
    ctx.fill();

    ctx.restore();
  }

  function drawCheck(ctx, cx, cy, scale = 1) {
    ctx.strokeStyle = C.white;
    ctx.lineWidth = 1.5 * scale;
    ctx.lineCap = 'round';
    ctx.beginPath();
    ctx.moveTo(cx - 2.4 * scale, cy);
    ctx.lineTo(cx - 0.6 * scale, cy + 2 * scale);
    ctx.lineTo(cx + 2.6 * scale, cy - 2 * scale);
    ctx.stroke();
  }

  function draw(ctx, w, h, progress, phase) {
    ctx.clearRect(0, 0, w, h);

    const route = buildRoute(w, h);
    const traveledLen = route.length * progress;
    const done = progress >= 0.999;

    const DASH = 5, GAP = 5, PERIOD = DASH + GAP;

    // ---- Pending dashed line (ambient march) ----
    const drift = (phase * 3 * PERIOD) % PERIOD;
    ctx.strokeStyle = C.pending;
    ctx.lineWidth = 2;
    ctx.lineCap = 'round';
    ctx.setLineDash([DASH, GAP]);
    ctx.lineDashOffset = -drift;

    ctx.beginPath();
    let started = false;
    for (const pt of route.points) {
      if (pt.len >= traveledLen) {
        if (!started) { ctx.moveTo(pt.x, pt.y); started = true; }
        else ctx.lineTo(pt.x, pt.y);
      }
    }
    ctx.stroke();
    ctx.setLineDash([]);

    // ---- Traveled solid line ----
    if (progress > 0.003) {
      ctx.strokeStyle = C.traveled;
      ctx.lineWidth = 2.6;
      ctx.lineCap = 'round';
      ctx.beginPath();
      ctx.moveTo(route.points[0].x, route.points[0].y);
      for (const pt of route.points) {
        if (pt.len > traveledLen) break;
        ctx.lineTo(pt.x, pt.y);
      }
      ctx.stroke();
    }

    // ---- Origin ----
    const origin = route.pointAt(0);
    ctx.beginPath();
    ctx.arc(origin.x, origin.y, 3.5, 0, Math.PI * 2);
    ctx.fillStyle = C.traveled;
    ctx.fill();

    // ---- Waypoints ----
    for (const wp of waypointFractions) {
      if (wp <= 0.01 || wp >= 0.99) continue;
      const pos = route.pointAt(wp);
      const reached = progress >= wp - 0.002;

      // Background punch
      ctx.beginPath();
      ctx.arc(pos.x, pos.y, 5.5, 0, Math.PI * 2);
      ctx.fillStyle = C.surface;
      ctx.fill();

      if (reached) {
        ctx.beginPath();
        ctx.arc(pos.x, pos.y, 3.8, 0, Math.PI * 2);
        ctx.fillStyle = C.traveled;
        ctx.fill();
      } else {
        ctx.beginPath();
        ctx.arc(pos.x, pos.y, 3.2, 0, Math.PI * 2);
        ctx.strokeStyle = C.pending;
        ctx.lineWidth = 1.8;
        ctx.stroke();
      }
    }

    // ---- Destination ----
    const dest = route.pointAt(1);
    ctx.beginPath();
    ctx.arc(dest.x, dest.y, 7, 0, Math.PI * 2);
    ctx.fillStyle = C.surface;
    ctx.fill();

    if (done) {
      ctx.beginPath();
      ctx.arc(dest.x, dest.y, 5.5, 0, Math.PI * 2);
      ctx.fillStyle = C.arrived;
      ctx.fill();
      drawCheck(ctx, dest.x, dest.y);
    } else {
      ctx.beginPath();
      ctx.arc(dest.x, dest.y, 5, 0, Math.PI * 2);
      ctx.strokeStyle = C.pending;
      ctx.lineWidth = 2;
      ctx.stroke();
      ctx.beginPath();
      ctx.arc(dest.x, dest.y, 2, 0, Math.PI * 2);
      ctx.fillStyle = C.pending;
      ctx.fill();
    }

    // ---- Airplane ----
    const planeProgress = Math.max(0.002, Math.min(0.998, progress));
    const planePt = route.pointAt(planeProgress);
    const nextPt = route.pointAt(Math.min(0.999, planeProgress + 0.003));
    const angle = Math.atan2(nextPt.y - planePt.y, nextPt.x - planePt.x);
    const planeColor = done ? C.arrived : C.traveled;

    drawPlane(ctx, planePt, angle, planeColor);
  }

  // ================================================================
  //  SCROLL / WAYPOINT CALCULATION
  // ================================================================
  function calcWaypoints() {
    // Map section elements to their scroll positions
    const sections = document.querySelectorAll('main > section');
    if (!sections.length) {
      waypointFractions = [0.2, 0.4, 0.6, 0.8];
      return;
    }

    const docH = document.documentElement.scrollHeight - window.innerHeight;
    if (docH <= 0) {
      waypointFractions = [0.2, 0.4, 0.6, 0.8];
      return;
    }

    waypointFractions = [];
    sections.forEach((section) => {
      const rect = section.getBoundingClientRect();
      const sectionTop = rect.top + window.scrollY;
      const frac = Math.max(0.02, Math.min(0.98, sectionTop / docH));
      waypointFractions.push(frac);
    });
  }

  // ================================================================
  //  BOOT — optimized: DPR=1, scroll-driven + slow ambient tick
  // ================================================================
  function init() {
    const canvas = document.getElementById('journey-canvas');
    if (!canvas) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let ambientPhase = 0;
    let ambientTimer = null;
    let currentProgress = 0;
    let needsDraw = true;

    calcWaypoints();

    function setup() {
      const rect = canvas.getBoundingClientRect();
      // DPR=1 — decorative element, retina is wasteful here
      canvas.width = rect.width;
      canvas.height = rect.height;
      const ctx = canvas.getContext('2d');
      return { ctx, w: rect.width, h: rect.height };
    }

    function drawFrame() {
      if (!needsDraw) return;
      const { ctx, w, h } = setup();
      draw(ctx, w, h, currentProgress, ambientPhase);
      needsDraw = false;
    }

    // Scroll-driven progress (instant redraw)
    function onScroll() {
      const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
      const progress = maxScroll > 0 ? Math.max(0, Math.min(1, window.scrollY / maxScroll)) : 0;
      if (progress !== currentProgress) {
        currentProgress = progress;
        needsDraw = true;
        drawFrame();
      }
    }

    // Ambient dashed line march (slow tick, ~4 updates/sec)
    function startAmbient() {
      if (reduceMotion) return;
      ambientTimer = setInterval(() => {
        ambientPhase = (ambientPhase + 0.1) % 1;
        needsDraw = true;
        drawFrame();
      }, 250);
    }

    window.addEventListener('scroll', onScroll, { passive: true });

    // Recalculate waypoints on resize (debounced)
    let resizeTimer;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        calcWaypoints();
        needsDraw = true;
        drawFrame();
      }, 300);
    });

    // Initial draw
    onScroll();
    startAmbient();

    // Cleanup
    window.addEventListener('beforeunload', () => {
      if (ambientTimer) clearInterval(ambientTimer);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>

<style>
  .journey-canvas {
    position: fixed;
    left: 0;
    top: 0;
    width: 72px;
    height: 100vh;
    height: 100dvh;
    z-index: 5;
    pointer-events: none;
  }

  @media (max-width: 768px) {
    .journey-canvas {
      width: 44px;
    }
  }

  @media (max-width: 480px) {
    .journey-canvas {
      display: none;
    }
  }
</style>
